# ---------------------------------------------------------------
# Server settings. Edit this file, then restart the server.
# Lines starting with # are comments. Format: NAME=value
# ---------------------------------------------------------------

# Where this API listens. Use 0.0.0.0 to accept connections from other machines.
APP_HOST=127.0.0.1
APP_PORT=8000

# Message broker: "memory" (nothing to install, messages lost on restart)
#              or "redis"  (durable, can be shared by several servers)
BROKER_BACKEND=memory

# How many times a failing message handler is retried before the message is dead-lettered.
BROKER_MAX_RETRIES=3

# ---- Only used when BROKER_BACKEND=redis ----
# Address of your Linux machine running Redis:
REDIS_HOST=192.168.0.10
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
# Prefix for all keys this app creates in Redis (lets several apps share one Redis).
REDIS_PREFIX=appserver
